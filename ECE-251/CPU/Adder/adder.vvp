:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56043b6db730 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x56043b6eda40 .scope module, "tb_adder" "tb_adder" 3 7;
 .timescale -9 -10;
P_0x56043b6edbd0 .param/l "WIDTH" 0 3 8, +C4<00000000000000000000000000100000>;
v0x56043b7055f0_0 .var "A", 31 0;
v0x56043b7056e0_0 .var "B", 31 0;
v0x56043b7057b0_0 .net "Sum", 31 0, L_0x56043b7058b0;  1 drivers
S_0x56043b6edc70 .scope task, "check_result" "check_result" 3 34, 3 34 0, S_0x56043b6eda40;
 .timescale -9 -10;
v0x56043b6ede50_0 .var "expected", 31 0;
TD_tb_adder.check_result ;
    %load/vec4 v0x56043b7057b0_0;
    %load/vec4 v0x56043b6ede50_0;
    %cmp/e;
    %jmp/0xz  T_0.0, 6;
    %vpi_call/w 3 36 "$display", "PASS: Sum = %h (expected %h)", v0x56043b7057b0_0, v0x56043b6ede50_0 {0 0 0};
    %jmp T_0.1;
T_0.0 ;
    %vpi_call/w 3 38 "$display", "FAIL: Sum = %h (expected %h)", v0x56043b7057b0_0, v0x56043b6ede50_0 {0 0 0};
T_0.1 ;
    %end;
S_0x56043b704f80 .scope module, "dut" "adder" 3 15, 4 14 0, S_0x56043b6eda40;
 .timescale 0 0;
    .port_info 0 /INPUT 32 "A";
    .port_info 1 /INPUT 32 "B";
    .port_info 2 /OUTPUT 32 "Sum";
P_0x56043b705180 .param/l "WIDTH" 0 4 15, +C4<00000000000000000000000000100000>;
v0x56043b7052a0_0 .net "A", 31 0, v0x56043b7055f0_0;  1 drivers
v0x56043b7053a0_0 .net "B", 31 0, v0x56043b7056e0_0;  1 drivers
v0x56043b705480_0 .net "Sum", 31 0, L_0x56043b7058b0;  alias, 1 drivers
L_0x56043b7058b0 .arith/sum 32, v0x56043b7055f0_0, v0x56043b7056e0_0;
    .scope S_0x56043b6eda40;
T_1 ;
    %vpi_call/w 3 23 "$dumpfile", "tb_adder.vcd" {0 0 0};
    %vpi_call/w 3 24 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56043b6eda40 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x56043b6eda40;
T_2 ;
    %vpi_call/w 3 29 "$monitor", "At time %t: A = %h, B = %h, Sum = %h", $time, v0x56043b7055f0_0, v0x56043b7056e0_0, v0x56043b7057b0_0 {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x56043b6eda40;
T_3 ;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v0x56043b7055f0_0, 0, 32;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v0x56043b7056e0_0, 0, 32;
    %delay 100, 0;
    %pushi/vec4 2, 0, 32;
    %store/vec4 v0x56043b6ede50_0, 0, 32;
    %fork TD_tb_adder.check_result, S_0x56043b6edc70;
    %join;
    %pushi/vec4 4294967295, 0, 32;
    %store/vec4 v0x56043b7055f0_0, 0, 32;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v0x56043b7056e0_0, 0, 32;
    %delay 100, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x56043b6ede50_0, 0, 32;
    %fork TD_tb_adder.check_result, S_0x56043b6edc70;
    %join;
    %pushi/vec4 305419896, 0, 32;
    %store/vec4 v0x56043b7055f0_0, 0, 32;
    %pushi/vec4 2271560481, 0, 32;
    %store/vec4 v0x56043b7056e0_0, 0, 32;
    %delay 100, 0;
    %pushi/vec4 2576980377, 0, 32;
    %store/vec4 v0x56043b6ede50_0, 0, 32;
    %fork TD_tb_adder.check_result, S_0x56043b6edc70;
    %join;
    %vpi_call/w 3 62 "$finish" {0 0 0};
    %end;
    .thread T_3;
