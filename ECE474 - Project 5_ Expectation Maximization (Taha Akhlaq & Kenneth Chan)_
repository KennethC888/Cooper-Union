{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["# **Project 5: Expectation Maximization**\n","Taha Akhlaq & Kenneth Chan\n"],"metadata":{"id":"S1ABDewU5AxP"}},{"cell_type":"code","execution_count":1,"metadata":{"id":"zupKTgYG7IDf","executionInfo":{"status":"ok","timestamp":1752263264763,"user_tz":240,"elapsed":5226,"user":{"displayName":"Taha Akhlaq","userId":"06924259513342345019"}}},"outputs":[],"source":["import numpy as np\n","import matplotlib.pyplot as plt\n","from scipy.stats import multivariate_normal\n","from sklearn.datasets import fetch_openml\n","import pandas as pd\n","import statsmodels.api as sm\n","from scipy.stats import norm\n","from matplotlib.patches import Ellipse\n","import matplotlib.transforms as transforms\n","\n","# axis = 0 is across col, axis = 1 is across the row\n","\n","np.random.seed(388)"]},{"cell_type":"code","source":["# Making 1D data using parameters that I choose and K = 3\n","def _1d_data():\n","    N = 100\n","    mus = [1, 3, 5]\n","    covars = [0.1, 0.2, 0.3]\n","    pis = [0.2, 0.3, 0.5] # Must add to 1\n","    X = []\n","    for i in range(N):\n","        k = np.random.choice(len(pis), p=pis)\n","        x = np.random.normal(mus[k], covars[k])\n","        X.append(x)\n","    return np.array(X)\n","\n","def Gauss_mixture_model_1d(X, K=3, max_iter=100):\n","    N = len(X)\n","    pi = np.ones(K) / K\n","    mu = np.random.choice(X, K)\n","    sigma = np.ones(K)\n","\n","    def calculate_log_likelihood():\n","        log_liklihood = 0\n","        for n in range(N):\n","            s = 0\n","            for k in range(K):\n","                s += pi[k] * norm.pdf(X[n], loc=mu[k], scale=np.sqrt(sigma[k]))\n","            log_liklihood += np.log(s)\n","        return log_liklihood\n","\n","    for i in range(max_iter):\n","        gamma = np.zeros((N, K))\n","        for k in range(K):\n","            gamma[:, k] = pi[k] * norm.pdf(X, loc=mu[k], scale=np.sqrt(sigma[k]))\n","        gamma = gamma / np.sum(gamma, axis=1, keepdims=True)\n","\n","        N_k = np.sum(gamma, axis=0)\n","        mu = (gamma.T @ X) / N_k\n","        for k in range(K):\n","            sigma[k] = np.sum(gamma[:, k] * (X - mu[k])**2) / N_k[k]\n","        pi = N_k / N\n","\n","    # PLOTTING TIME\n","    plt.hist(X, bins=30, density=True, alpha=0.5, label='data')\n","    x_plot = np.linspace(X.min() - 1, X.max() + 1, 500)\n","    y = np.zeros_like(x_plot)\n","    for k in range(K):\n","        y += pi[k] * norm.pdf(x_plot, loc=mu[k], scale=np.sqrt(sigma[k]))\n","    plt.plot(x_plot, y, label='fit')\n","    plt.title('EM 1D')\n","    plt.legend()\n","    plt.show()\n","\n","X1d = _1d_data()\n","Gauss_mixture_model_1d(X1d)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":452},"id":"mB-FtJWOBUsx","executionInfo":{"status":"ok","timestamp":1752263265255,"user_tz":240,"elapsed":474,"user":{"displayName":"Taha Akhlaq","userId":"06924259513342345019"}},"outputId":"7130fc30-c682-4fe3-b488-bfb978886bfb"},"execution_count":2,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# 2D case where K = 2 and using Old Faithful dataset\n","\n","def load_faithful():\n","    data = sm.datasets.get_rdataset(\"faithful\", \"datasets\").data\n","    return data[[\"eruptions\", \"waiting\"]].values\n","\n","def draw_ellipse(mean, cov, ax=None, color='g'):\n","\n","    if ax is None:\n","        ax = plt.gca()\n","\n","    a,b = np.linalg.eigh(cov)\n","    order = a.argsort()[::-1]\n","    a,b = a[order], b[:, order]\n","\n","    angle = np.degrees(np.arctan2(*b[:, 0][::-1]))\n","    width, height = 2 * np.sqrt(a)\n","    ellip = Ellipse(xy=mean, width=width, height=height, angle=angle,\n","                    edgecolor=color, facecolor='none', lw=2)\n","    ax.add_patch(ellip)\n","\n","def Gauss_mixture_model_2d(X, K=2, max_iter=100):\n","    N, D = X.shape\n","    # Init\n","    pi = np.ones(K) / K\n","    idx = np.random.choice(N, K, replace=False)\n","    mu = X[idx]\n","    Sigma = np.array([np.cov(X.T) for _ in range(K)])\n","\n","    for i in range(max_iter):\n","        # E-step\n","        gamma = np.zeros((N, K))\n","        for k in range(K):\n","            rv = multivariate_normal(mean=mu[k], cov=Sigma[k])\n","            gamma[:, k] = pi[k] * rv.pdf(X)\n","        gamma /= gamma.sum(axis=1, keepdims=True)\n","\n","        # M-step\n","        Nk = gamma.sum(axis=0)\n","        mu = (gamma.T @ X) / Nk[:, None]\n","        for k in range(K):\n","            X_centered = X - mu[k]\n","            Sigma[k] = (gamma[:, k][:, None] * X_centered).T @ X_centered / Nk[k]\n","        pi = Nk / N\n","\n","        if i in [0, 2, 5, 50, max_iter - 1]:\n","            plt.figure(figsize=(6, 5))\n","            plt.scatter(X[:, 0], X[:, 1], c=gamma.argmax(axis=1), s=10, cmap='viridis')\n","            plt.title(f'2D GMM Clustering at iteration {i}')\n","            for k in range(K):\n","                draw_ellipse(mu[k], Sigma[k])\n","            plt.xlabel(\"Eruption duration (mins)\")\n","            plt.ylabel(\"Waiting time (mins)\")\n","            plt.show()\n","\n","X2d = load_faithful()\n","Gauss_mixture_model_2d(X2d)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"Ej8WmR55Bmoq","executionInfo":{"status":"ok","timestamp":1752263267685,"user_tz":240,"elapsed":2426,"user":{"displayName":"Taha Akhlaq","userId":"06924259513342345019"}},"outputId":"ab0a0c1f-52ba-4c19-8d5b-35a2a6ca7dd0"},"execution_count":3,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"dis